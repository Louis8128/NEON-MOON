# App runtime
NODE_ENV="production"

# Public site URL for metadata, sitemap, robots, RSS, and canonical links
NEXT_PUBLIC_SITE_URL="https://your-domain.example"

# Prisma CLI / migrations
# For docker-compose.prod.yml, use mysql as the database host.
DATABASE_URL="mysql://<db_user>:<db_password>@<db_host>:3306/<db_name>"

# App database runtime
DATABASE_HOST="<db_host>"
DATABASE_PORT=3306
DATABASE_USER="<db_user>"
DATABASE_PASSWORD="<db_password>"
DATABASE_NAME="<db_name>"
MYSQL_ROOT_PASSWORD="<replace-with-strong-root-password>"

# Admin auth
ADMIN_PASSWORD="<replace-with-strong-admin-password>"
ADMIN_SESSION_SECRET="<replace-with-32-byte-base64-secret>"

# Generate ADMIN_SESSION_SECRET with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Future object storage, not used yet
# STORAGE_BUCKET=""
# STORAGE_REGION=""
# STORAGE_ENDPOINT=""
# STORAGE_ACCESS_KEY_ID=""
# STORAGE_SECRET_ACCESS_KEY=""
# UPLOAD_PUBLIC_BASE_URL=""
