generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum MediaCategory {
  MUSIC
  BOOK
  MOVIE
  ANIME
  GAME
}

model MediaItem {
  id          Int           @id @default(autoincrement())
  title       String
  category    MediaCategory
  creator     String?
  releaseYear Int?
  coverUrl    String?
  rating      Float?
  note        String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model BlogPost {
  id            Int      @id @default(autoincrement())
  title         String
  slug          String   @unique
  excerpt       String?  @db.Text
  content       String   @db.Text
  coverImageUrl String?
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Photo {
  id          Int       @id @default(autoincrement())
  title       String
  imageUrl    String
  location    String?
  description String?   @db.Text
  takenAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}